# Copy to .env.local and adjust as needed.
#
# If MONGODB_URI is left unset, the app automatically boots an embedded
# local MongoDB instance (mongodb-memory-server) persisted under db/data.
# Point this at your own mongod or a Supabase/Atlas URI to override.
MONGODB_URI=

# Database name used by the app
MONGODB_DB=fablefile

# ---- OAuth scaffolding (NextAuth v5 / Auth.js) ------------------------
# The mock email login always works; filling these in activates the real
# OAuth buttons in the auth modal. Generate a secret with `npx auth secret`
# (or `openssl rand -base64 32`).
AUTH_SECRET=

# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple (https://developer.apple.com/account/resources)
# Redirect URI: http://localhost:3000/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
